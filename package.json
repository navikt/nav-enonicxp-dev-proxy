{
    "name": "nav-enonicxp-dev-proxy",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": "26"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "scripts": {
        "build": "rm -fr dist && tsc",
        "start": "node dist/server.js",
        "dev": "pnpm build && concurrently \"tsc -w\" \"NODE_ENV=development node --watch --watch-preserve-output dist/server.js\""
    },
    "dependencies": {
        "express": "5.3.0",
        "express-http-proxy": "2.1.2"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/express-http-proxy": "1.6.7",
        "@types/node": "26.6.6",
        "concurrently": "10.0.6",
        "eslint": "10.14.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3"
    }
}
